{
    "cmake.cmakePath": "${userHome}/.local/bin/cmake",
    "cmake.options.statusBarVisibility": "visible",
    "cmake.buildDirectory": "${workspaceFolder}/builds/${buildKit}/${buildType}",
    "cmake.useCMakePresets": "never",
    "files.associations": {
        "source_location": "cpp"
    },
    "cmake.buildArgs": [
        "-DCMAKE_TOOLCHAIN_FILE=${userHome}/vcpkg/scripts/buildsystems/vcpkg.cmake"
    ]
}